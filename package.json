{
  "name": "pi-web-skills",
  "version": "0.2.0",
  "type": "module",
  "description": "PI WEB panel for managing the agent skills Pi loads from ~/.agents/skills",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elementalvoid/pi-web-skills.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-web.dev-plugin",
    "pi-web-plugin",
    "pi-package",
    "pi-web",
    "pi-web-ui",
    "pi-coding-agent",
    "developer-tools",
    "productivity",
    "agent-skills",
    "agent-skills-manager",
    "skills-manager",
    "skill-md",
    "skills-sh",
    "claude-skills",
    "skills"
  ],
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp src/browser/skills-panel.css dist/browser/skills-panel.css",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "test:e2e": "npm run build && node e2e/skills-panel.e2e.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@jmfederico/pi-web": "^1.202610.6",
    "@types/node": "^24.13.3",
    "playwright": "1.63.0",
    "skills": "1.7.4",
    "typescript": "^6.0.3"
  },
  "piWeb": {
    "plugins": [
      {
        "id": "skills",
        "browserRoot": "dist/browser",
        "module": "dist/browser/index.js",
        "serverModule": "dist/server.js",
        "machineSpecific": true
      }
    ]
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "GLOSSARY.md",
    "README.md",
    "src/vendor/skills/LICENSE"
  ]
}
