{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    // Off only because the verbatim upstream subset in src/vendor/skills assigns
    // undefined to optional properties. Every other strict flag stays on, the
    // subset stays unedited, and there is no second tsconfig project: re-enable
    // this flag only if the subset is replaced by a typed package.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": false,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
